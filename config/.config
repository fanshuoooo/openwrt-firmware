#
# ImmortalWrt 24.10 configuration for Xiaomi Mi Router CR6608
# *** firmware4: stable base for flashing new CR6608 routers via breed ***
# Target: ramips/mt7621, WiFi: MT7915E (mac80211 upstream driver)
# Changes vs firmware3:
#   - dropped AdGuardHome / zerotier / mwan3 / UnblockMusic / wireguard
#   - frpc & passwall installed but NOT auto-started (enabled per customer)
#

# ---- Target ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y

# ---- Image ----
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_GRUB_IMAGES=n
CONFIG_ISO_IMAGES=n

# ---- Base / LuCI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Theme: bootstrap only (luci-theme-design crashes on 24.10 ucode LuCI)
# CONFIG_PACKAGE_luci-theme-design is not set

# ---- Proxy: PassWall (installed, NOT auto-started) ----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ChinaDNS_NG=y

# ---- Proxy: SSR Plus (installed, NOT auto-started) ----
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=y

# ---- DNS helpers ----
CONFIG_PACKAGE_chinadns-ng=y

# ---- Network tools ----
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_tcping=y

# ---- Wireless driver (MT7915E, CR6608 native per ImmortalWrt DTS) ----
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y

# ---- Utilities ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# ---- Storage / USB ----
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ---- Misc ----
CONFIG_PACKAGE_zram-swap=y

# ---- IPv6 ----
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip6tables=y

# ---- fullcone NAT (ImmortalWrt firewall feature, enabled on live router) ----
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ---- Explicitly excluded ----
# CONFIG_PACKAGE_omcproxy is not set
# CONFIG_PACKAGE_set-irq-affinity is not set
